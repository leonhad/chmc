# Makefile for the CHM builder in C++17.
#
# Main targets:
#   make            builds chmc.exe
#   make run        generates example/project.chm
#   make clean      removes generated objects and executables
#   make test       validates with libmspack when it is available

.DEFAULT_GOAL := all

CXX      ?= c++
CXXFLAGS ?= -std=c++17 -O2 -Wall -Wextra -Wpedantic
CPPFLAGS ?=
LDFLAGS  ?=
LDLIBS   ?=
DEPFLAGS  = -MMD -MP

# libmspack is optional and detected with pkg-config. Both flags can be
# overridden on the command line, e.g. make MSPACK_LIBS=-lmspack.
MSPACK_CFLAGS ?= $(shell pkg-config --cflags libmspack 2>/dev/null)
MSPACK_LIBS   ?= $(shell pkg-config --libs libmspack 2>/dev/null)
HAVE_MSPACK   := $(if $(strip $(MSPACK_LIBS)),yes,no)

TARGET := chmc.exe
SRC    := src/main.cpp src/chm.cpp src/lzx.cpp
OBJ    := $(SRC:.cpp=.o)
DEPS   := $(OBJ:.o=.d)
TEST_CHM := test_chm.exe

.PHONY: all run clean rebuild help test test-chm

all: $(TARGET)

$(TARGET): $(OBJ)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $(OBJ) $(LDLIBS)

%.o: %.cpp
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

-include $(DEPS)

run: $(TARGET)
	./$(TARGET) example/project.hhp example/project.chm

rebuild: clean all

clean:
	$(RM) $(OBJ) $(DEPS) $(TARGET) $(TEST_CHM)
	$(RM) lzx_test.lzx lzx_test.out

help:
	@echo "Available targets:"
	@echo "  all        builds $(TARGET) (default)"
	@echo "  run        generates example/project.chm"
	@echo "  clean      removes generated objects and executables"
	@echo "  rebuild    runs clean and all"
	@echo "  test       runs test-chm when libmspack is available"
	@echo "  test-chm   validates CHM extraction with libmspack"

# ---------------------------------------------------------------------------
# Tests with libmspack (optional)
# ---------------------------------------------------------------------------

ifeq ($(HAVE_MSPACK),yes)

test: test-chm

test-chm: $(TARGET) $(TEST_CHM)
	./$(TARGET) example/project.hhp example/project.chm
	./$(TEST_CHM) example/project.chm example

$(TEST_CHM): src/test_chm.cpp
	$(CXX) $(CXXFLAGS) $(LDFLAGS) $(MSPACK_CFLAGS) -o $@ $< $(MSPACK_LIBS) $(LDLIBS)

else

test:
	@echo "libmspack not found (install it or set MSPACK_LIBS); tests skipped"

test-chm:
	@echo "libmspack not found; test-chm skipped"

endif
